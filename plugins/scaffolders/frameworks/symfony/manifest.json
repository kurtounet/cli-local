{
  "id": "symfony",
  "name": "Symfony Scaffolder",
  "type": "scaffolder",
  "service": "index.js",
  "templateDir": "templates",
  "blueprints": [
    {
      "name": "controller",
      "template": "controller/controller.php.ejs"
    },
    {
      "type": "resource",
      "scope": "entity",
      "target": "src/ApiResource/Resources",
      "template": "api-platform/resource/resource.php.ejs",
      "suffix": "Resource",
      "platform": "api-platform"
    },
    {
      "type": "mapper",
      "scope": "entity",
      "target": "src/ApiResource/Mappers",
      "template": "api-platform/mapper/mapper.php.ejs",
      "suffix": "Mapper",
      "platform": "api-platform"
    },
    {
      "type": "provider",
      "scope": "entity",
      "target": "src/ApiResource/States/<%= entity.namePascalCase %>",
      "template": "api-platform/state/provider.php.ejs",
      "suffix": "ItemProvider",
      "platform": "api-platform"
    },
    {
      "type": "provider-collection",
      "scope": "entity",
      "target": "src/ApiResource/States/<%= entity.namePascalCase %>",
      "template": "api-platform/state/collection-provider.php.ejs",
      "suffix": "CollectionProvider",
      "platform": "api-platform"
    },
    {
      "type": "processor",
      "scope": "entity",
      "target": "src/ApiResource/States/<%= entity.namePascalCase %>",
      "template": "api-platform/state/processor.php.ejs",
      "suffix": "CreateProcessor",
      "platform": "api-platform"
    },
    {
      "type": "processor",
      "scope": "entity",
      "target": "src/ApiResource/States/<%= entity.namePascalCase %>",
      "template": "api-platform/state/update-processor.php.ejs",
      "suffix": "UpdateProcessor",
      "platform": "api-platform"
    },
    {
      "type": "processor",
      "scope": "entity",
      "target": "src/ApiResource/States/<%= entity.namePascalCase %>",
      "template": "api-platform/state/delete-processor.php.ejs",
      "suffix": "DeleteProcessor",
      "platform": "api-platform"
    },
    {
      "type": "entity",
      "scope": "entity",
      "target": "src/Entity",
      "template": "entity/entity.php.ejs",
      "suffix": "",
      "platform": "symfony"
    },
    {
      "type": "repository",
      "scope": "entity",
      "target": "src/Repository",
      "template": "repository/repository.php.ejs",
      "suffix": "Repository",
      "platform": "symfony"
    },
    {
      "type": "dto",
      "scope": "entity",
      "target": "src/ApiResource/Dtos/<%= entity.namePascalCase %>",
      "template": "api-platform/dto/item-dto.php.ejs",
      "suffix": "ItemDto",
      "platform": "api-platform"
    },
    {
      "type": "dto",
      "scope": "entity",
      "target": "src/ApiResource/Dtos/<%= entity.namePascalCase %>",
      "template": "api-platform/dto/collection-item-dto.php.ejs",
      "suffix": "CollectionItemDto",
      "platform": "api-platform"
    },
    {
      "type": "dto",
      "scope": "entity",
      "target": "src/ApiResource/Dtos/<%= entity.namePascalCase %>",
      "template": "api-platform/dto/create-dto.php.ejs",
      "suffix": "CreateDto",
      "platform": "api-platform"
    },
    {
      "type": "dto",
      "scope": "entity",
      "target": "src/ApiResource/Dtos/<%= entity.namePascalCase %>",
      "template": "api-platform/dto/update-dto.php.ejs",
      "suffix": "UpdateDto",
      "platform": "api-platform"
    },
    {
      "type": "controller",
      "scope": "entity",
      "target": "src/Controller",
      "template": "controller/controller.php.ejs",
      "suffix": "Controller",
      "platform": "symfony"
    },
    {
      "type": "service",
      "scope": "entity",
      "target": "src/Service",
      "template": "service/service.php.ejs",
      "suffix": "Service",
      "platform": "symfony"
    },
    {
      "type": "test",
      "scope": "entity",
      "target": "tests/Controller",
      "template": "test/test.php.ejs",
      "suffix": "ControllerTest",
      "platform": "symfony"
    },
    {
      "type": "service",
      "scope": "project",
      "target": "src/ApiResource/Services",
      "template": "api-platform/service/iri-from-resource.php.ejs",
      "suffix": "",
      "platform": "api-platform"
    },
    {
      "type": "command",
      "scope": "project",
      "target": "src/Command",
      "template": "command/crud-all.php.ejs",
      "suffix": "",
      "platform": "symfony"
    },
    {
      "type": "env",
      "scope": "project",
      "target": "./",
      "template": "env/env.local.ejs",
      "filename": ".env.local",
      "platform": "symfony"
    }
  ]
}