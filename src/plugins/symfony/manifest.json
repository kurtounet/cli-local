{
  "name": "Symfony Generator",
  "id": "symfony",
  "service": "symfony.service.js",
  "templateDir": "./templates",
  "blueprints": [
    {
      "type": "entity",
      "target": "src/Entity",
      "suffix": ""
    },
    {
      "type": "dto",
      "target": "src/Dto",
      "suffix": "Dto"
    }
  ]
}