<% if (relation.relationType === 'OneToOne' || relation.relationType === 'ManyToOne') { %>
public function get<%= relation.namePascalCase %>(): ?<%= relation.targetPascalCase %>
{
    return $this-><%= relation.nameCamelCase %>;
}

public function set<%= relation.namePascalCase %>(?<%= relation.targetPascalCase %> $<%= relation.nameCamelCase %>): static
{
    $this-><%= relation.nameCamelCase %> = $<%= relation.nameCamelCase %>;
    return $this;
}
<% } else if (relation.relationType === 'OneToMany' || relation.relationType === 'ManyToMany') { %>
/**
 * @return Collection<int, <%= relation.targetPascalCase %>>
 */
public function get<%= relation.namePascalCase %>(): Collection
{
    return $this-><%= relation.nameCamelCase %>;
}

public function add<%= relation.targetPascalCaseSingular %> (<%= relation.targetPascalCase %> $<%= relation.targetCamelCaseSingular %>): static
{
    if (!$this-><%= relation.nameCamelCase %>->contains($<%= relation.targetCamelCaseSingular %>)) {
        $this-><%= relation.nameCamelCase %>->add($<%= relation.targetCamelCaseSingular %>);
        <% if (relation.mappedBy) { %>
        $<%= relation.targetCamelCaseSingular %>->set<%= relation.ownerPascalCase %>>($this);
        <% } %>
    }

    return $this;
}

public function remove<%= relation.targetPascalCaseSingular %> (<%= relation.targetPascalCase %> $<%= relation.targetCamelCaseSingular %>): static
{
    if ($this-><%= relation.nameCamelCase %>->removeElement($<%= relation.targetCamelCaseSingular %>)) {
        <% if (relation.mappedBy) { %>
        // set the owning side to null (unless already changed)
        if ($<%= relation.targetCamelCaseSingular %>->get<%= relation.ownerPascalCase %>() === $this) {
            $<%= relation.targetCamelCaseSingular %>->set<%= relation.ownerPascalCase %>(null);
        }
        <% } %>
    }

    return $this;
}
<% } %>
