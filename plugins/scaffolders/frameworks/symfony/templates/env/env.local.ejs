###> symfony/framework-bundle ###
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=<%= project.env.APP_SECRET %>
###< symfony/framework-bundle ###

<% if (project.db) { %>
###> doctrine/doctrine-bundle ###
DATABASE_URL="<%= project.db.url %>" 
###< doctrine/doctrine-bundle ###
<% } %>

<% if (project.mailer) { %>
###> symfony/mailer ###
MAILER_DSN=<%= project.mailer.dsn %>
###< symfony/mailer ###
<% } %>

<% if (project.cors) { %>
###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='<%= project.cors.allow_origin %>'
###< nelmio/cors-bundle ###
<% } %>

<% if (project.jwt) { %>
###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=<%= project.jwt.passphrase %>
###< lexik/jwt-authentication-bundle ###
<% } %>
