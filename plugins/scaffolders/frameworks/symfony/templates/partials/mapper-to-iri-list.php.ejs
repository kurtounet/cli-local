private function toIriList(iterable $items, string $resourceClass): array
{
    $iris = [];

    foreach ($items as $item) {
        if (!is_object($item) || !method_exists($item, 'getId')) {
            continue;
        }

        $iri = ($this->iriFromResource)($resourceClass, $item->getId());
        if (null !== $iri) {
            $iris[] = $iri;
        }
    }
    return $iris;
}
