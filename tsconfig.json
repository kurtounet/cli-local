{
  "compilerOptions": {
    //* Standard & Target */
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext"
    ],
    "types": [
      "node"
    ],
    //* Chemins & Structure */
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@commands/*": [
        "./commands/*"
      ],
      "@features/*": [
        "./features/*"
      ],
      "@project/*": [
        "./features/project/*"
      ],
      "@parsersMdj/*": [
        "./features/parsersMdj/*"
      ],
      "@frameworks/*": [
        "./features/frameworks/*"
      ],
      "@angular/*": [
        "./features/frameworks/angular/*"
      ],
      "@electron/*": [
        "./features/frameworks/electron/*"
      ],
      "@nestjs/*": [
        "./features/frameworks/nestjs/*"
      ],
      "@nitro/*": [
        "./features/frameworks/nitro/*"
      ],
      "@nuxt/*": [
        "./features/frameworks/nuxt/*"
      ],
      "@react/*": [
        "./features/frameworks/react/*"
      ],
      "@symfony/*": [
        "./features/frameworks/symfony/*"
      ],
      "@vue/*": [
        "./features/frameworks/vue/*"
      ],
      "@frameworks-models/*": [
        "./features/frameworks/models/*"
      ],
      "@frameworks-services/*": [
        "./features/frameworks/services/*"
      ],
      "@constants/*": [
        "constants/*"
      ],
      "@helpers/*": [
        "./helpers/*"
      ],
      "@mocks/*": [
        "./mocks/*"
      ],
      "@templates/*": [
        "./templates/*"
      ],
      "@services/*": [
        "./services/*"
      ],
      "@models/*": [
        "./models/*"
      ],
      "@utils/*": [
        "./utils/*"
      ],
      "@utils/file-utils": [
        "./utils/file-utils"
      ],
      "@utils/stringUtils": [
        "./utils/string-utils"
      ],
      "@utils/execute-command": [
        "./utils/execute-command"
      ]
    },
    //* Rigueur & Qualité */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    //* Interopérabilité */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}