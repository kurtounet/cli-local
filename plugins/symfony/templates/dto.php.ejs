<?php

namespace App\Dto;

/**
 * DTO <%= entity.name %>Dto
 * Généré automatiquement par le SDK
 */
class <%= entity.name %>Dto
{
<% entity.fields.forEach(field => { %>
    /**
     * @var <%= field.type %>
     */
    private $<%= field.name %>;
<% }) %>

    /**
     * Constructeur
     */
    public function __construct(
<% entity.fields.forEach((field, index) => { %>
        <%= field.type %> $<%= field.name %><%= index < entity.fields.length - 1 ? ',' : '' %>
<% }) %>
    ) {
<% entity.fields.forEach(field => { %>
        this-><%= field.name %> = $<%= field.name %>;
<% }) %>
    }

<% entity.fields.forEach(field => { %>
    /**
     * @return <%= field.type %>
     */
    public function get<%= field.name.charAt(0).toUpperCase() + field.name.slice(1) %>(): <%= field.type %>
    {
        return $this-><%= field.name %>;
    }
<% }) %>
}