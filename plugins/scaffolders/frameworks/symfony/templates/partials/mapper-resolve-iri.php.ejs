private function resolveIri(?string $iri, string $expectedClass, string $field, bool $required = false): ?object
{
    if ($iri === null || $iri === '') {
        if ($required) {
            throw new \Symfony\Component\HttpKernel\Exception\BadRequestHttpException(sprintf(
                'Field "%s" is required and must be a non-empty IRI string.',
                $field
            ));
        }
        return null;
    }

    try {
        $resource = $this->iriConverter->getResourceFromIri($iri);
    } catch (\Throwable $e) {
        throw new \Symfony\Component\HttpKernel\Exception\BadRequestHttpException(sprintf('Invalid IRI for field "%s".', $field), $e);
    }

    if ($resource instanceof $expectedClass) {
        return $resource;
    }

    $id = null;
    if (is_object($resource) && property_exists($resource, 'id')) {
        $id = $resource->id;
    }

    if ($id === null && preg_match('~/(\d+)$~', $iri, $m)) {
        $id = (int) $m[1];
    }

    if ($id === null) {
        throw new \Symfony\Component\HttpKernel\Exception\BadRequestHttpException(sprintf(
            'Invalid IRI type for field "%s". Expected "%s".',
            $field,
            $expectedClass
        ));
    }

    $entity = $this->em->getRepository($expectedClass)->find($id);

    if (!$entity) {
        throw new \Symfony\Component\HttpKernel\Exception\BadRequestHttpException(sprintf(
            'Resource not found for field "%s" (id: %s).',
            $field,
            (string) $id
        ));
    }

    return $entity;
}
