<?php

namespace App\ApiResource\States\<%= entity.namePascalCase %>;

use App\Entity\<%= entity.namePascalCase %>;
use ApiPlatform\Metadata\Patch;
use ApiPlatform\Metadata\Operation;
use App\ApiResource\Mappers\<%= entity.namePascalCase %>Mapper;
use Doctrine\ORM\EntityManagerInterface;
use ApiPlatform\State\ProcessorInterface;
use Symfony\Component\DependencyInjection\Attribute\Autowire;
use App\ApiResource\Dtos\<%= entity.namePascalCase %>\<%= entity.namePascalCase %>UpdateDto;

final readonly class <%= entity.namePascalCase %>UpdateProcessor implements ProcessorInterface
{
    public function __construct(
        private EntityManagerInterface $em,
        private <%= entity.namePascalCase %>Mapper $<%= entity.nameCamelCase %>Mapper,
        #[Autowire(service: 'api_platform.doctrine.orm.state.persist_processor')]
        private ProcessorInterface $persistProcessor,
    ) {}

    public function process(mixed $data, Operation $operation, array $uriVariables = [], array $context = []): mixed
    {
        if (!($operation instanceof Patch) || !($data instanceof <%= entity.namePascalCase %>UpdateDto)) {
            return $data;
        }

        $id = $uriVariables['id'] ?? null;
        if (!is_string($id) && !is_int($id)) {
            throw new \InvalidArgumentException('Missing "id" uriVariable for PATCH.');
        }

        $entity = $this->em->getRepository(<%= entity.namePascalCase %>::class)->find($id);

        if (!$entity instanceof <%= entity.namePascalCase %>) {
            throw new \RuntimeException(sprintf('Entity %s#%s not found.', <%= entity.namePascalCase %>::class, (string) $id));
        }

        $updatedEntity = $this-><%= entity.nameCamelCase %>Mapper->updateDtoToEntity($data, $entity);
        $persistedEntity = $this->persistProcessor->process($updatedEntity, $operation, $uriVariables, $context);

        return  $this-><%= entity.nameCamelCase %>Mapper->entityToItemDto($persistedEntity);
    }
}
