<?php

namespace App\ApiResource\Dtos\<%= entity.namePascalCase %>;

use Symfony\Component\Validator\Constraints as Assert;
use Symfony\Component\Serializer\Attribute\Groups;

final class <%= entity.namePascalCase %>CreateDto
{
    <% entity.columns?.forEach(col => { %>
    <% if (!["id", "created_at", "updated_at"].includes(col.name)) { %>
    #[Groups(['<%= entity.namePascalCase %>:create'])]
    #[Assert\NotBlank]
    public ?<%- col.phpType %> $<%= col.nameCamelCase %> = null;
    <% } %>
    <% }) %>

    <%# Add relations as IRI strings %>
    <% entity.relationships?.forEach(relation => { %>
    #[Groups(['<%= entity.namePascalCase %>:create'])]
    #[Assert\NotBlank]
    public ?string $<%= relation.nameCamelCase %> = null;
    <% }) %>
}
